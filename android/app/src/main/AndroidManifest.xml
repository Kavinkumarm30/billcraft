<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions required for hardware camera, network, and file sharing -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BillCraft"
        android:usesCleartextTraffic="false">

        <!-- Splash Activity (Launcher) -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.BillCraft.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Screen -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Dashboard -->
        <activity
            android:name=".ui.DashboardActivity"
            android:exported="false" />

        <!-- Multi-Page Document Camera Snapper -->
        <activity
            android:name=".ui.MultiPageCameraActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- AI OCR Line Items Review & Editor -->
        <activity
            android:name=".ui.ReviewOcrActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Native Invoice PDF Preview & WhatsApp Share -->
        <activity
            android:name=".ui.InvoicePreviewActivity"
            android:exported="false" />

        <!-- Invoices List & Customer Directory -->
        <activity
            android:name=".ui.InvoicesListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CustomersActivity"
            android:exported="false" />

        <!-- FileProvider for Sharing Generated Invoice PDFs to WhatsApp / Gmail -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>

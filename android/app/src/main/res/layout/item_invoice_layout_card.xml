<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_white_metric_card"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_stat_blue_icon">

        <TextView
            android:id="@+id/tvLayoutIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🎨"
            android:textSize="20sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLayoutName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard"
                android:textColor="#111827"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLayoutBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_stat_amber_icon"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Logo Left"
                android:textColor="#92400E"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLayoutDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Classic business invoice with company details on the left"
            android:textColor="#6B7280"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvActiveBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_stat_green_icon"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="✓ Active"
        android:textColor="#16A34A"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnSelectLayout"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:backgroundTint="#F3F4F6"
        android:text="Select"
        android:textColor="#111827"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
